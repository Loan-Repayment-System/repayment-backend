{
  "uid": "collection-result-pending",
  "title": "펌뱅킹 장애 부하 테스트",
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "schemaVersion": 41,
  "editable": true,
  "tags": [
    "load-test"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "상태별 집금 요청 건수",
      "description": "복구 뒤 REQUESTED가 0으로 수렴하는가",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "collection_request_count",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "상환 응답 코드별 초당 건수",
      "description": "장애 구간에 202(처리 중)로 바뀌고, 복구 뒤 200으로 돌아오는가",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (status) (rate(k6_http_reqs_total{name=\"POST /api/loans/{id}/repayments\"}[30s]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "상환 실패율",
      "description": "200·202 말고 5xx나 시간 초과가 나는가",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(rate(k6_http_reqs_total{name=\"POST /api/loans/{id}/repayments\",expected_response=\"false\"}[30s]) or vector(0)) / sum(rate(k6_http_reqs_total{name=\"POST /api/loans/{id}/repayments\"}[30s]))",
          "legendFormat": "실패율"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "dropped_iterations",
      "description": "의도한 초당 15건이 실제로 나갔는가 (0이어야 한다)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(k6_dropped_iterations_total) or vector(0)",
          "legendFormat": "누적"
        }
      ]
    }
  ]
}
